rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Staff = admin (egy település kezelője) vagy developer (platform-szintű,
    // több települést kezel). A developer mindenhez hozzáfér, amihez az admin.
    function staffRoles() {
      return ['admin', 'developer'];
    }

    // Primary admin check: UID-based only (cannot be spoofed by creating a doc)
    function adminByUid() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in staffRoles();
    }

    // Email-doc fallback: also requires a uid field in the doc matching the caller
    function adminByEmailDoc() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role in staffRoles()
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.uid == request.auth.uid;
    }

    function isAdmin() {
      return adminByUid() || adminByEmailDoc();
    }

    // Csak developer: a platform-szintű település (projekt) kezeléséhez.
    function isDeveloper() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer';
    }

    // ── White-label: tenant-izoláció ──────────────────────────────────────
    // Az alapértelmezett település. A projectId NÉLKÜLI dokumentumok ide
    // tartoznak (visszamenőleges kompatibilitás a migráció előtti adattal).
    function defaultProject() {
      return 'nagyvazsony';
    }

    // Egy dokumentum települése.
    function docProject(data) {
      return 'projectId' in data ? data.projectId : defaultProject();
    }

    // A bejelentkezett admin SAJÁT települése (users/{uid}.projectId).
    function myProject() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'projectId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.projectId
        : defaultProject();
    }

    // Tartalom létrehozása/módosítása: a developer bármelyik településen,
    // az admin CSAK a sajátján.
    function canCreateContent() {
      return isDeveloper()
        || (isAdmin() && docProject(request.resource.data) == myProject());
    }

    function canUpdateContent() {
      return isDeveloper()
        || (isAdmin()
            && docProject(resource.data) == myProject()
            && docProject(request.resource.data) == myProject());
    }

    function canDeleteContent() {
      return isDeveloper() || (isAdmin() && docProject(resource.data) == myProject());
    }

    // Települések (white-label projektek): bárki olvashatja (a mobil app is
    // választ belőle), de csak a developer hozhat létre/módosíthat.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isDeveloper();
    }

    // Validates a user's self-write to their own progress document:
    // - totalPoints can only increase (no direct point reduction)
    // - completedStations can only grow (no removing completed stations)
    function isValidProgressUpdate() {
      let incoming = request.resource.data;
      let existing = resource.data;
      let pointsOk = !incoming.keys().hasAny(['totalPoints'])
        || incoming.totalPoints >= (existing.get('totalPoints', 0));
      let stationsOk = !incoming.keys().hasAny(['completedStations'])
        || incoming.completedStations.hasAll(existing.get('completedStations', []));
      return pointsOk && stationsOk;
    }

    match /user_progress/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Admin: unrestricted write
      allow write: if isAdmin();

      // User: can only write to their own doc, with monotonic constraints.
      // Create is restricted to zeroed counters so a fresh doc cannot start
      // with fabricated points or completed items.
      allow create: if isSignedIn() && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['totalPoints'])
            || request.resource.data.totalPoints == 0)
        && (!request.resource.data.keys().hasAny(['completedStations'])
            || request.resource.data.completedStations.size() == 0)
        && (!request.resource.data.keys().hasAny(['completedEvents'])
            || request.resource.data.completedEvents.size() == 0)
        && (!request.resource.data.keys().hasAny(['completedTripIds'])
            || request.resource.data.completedTripIds.size() == 0);
      allow update: if isSignedIn() && request.auth.uid == userId && isValidProgressUpdate();

      match /completed_stations/{stationId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /completed_events/{eventId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /unlocked_achievements/{achievementId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || (request.auth.token.email != null && request.auth.token.email == userId)
        || isAdmin()
      );
      allow create: if isSignedIn() && (
        request.auth.uid == userId
        || (request.auth.token.email != null && request.auth.token.email == userId)
      ) && (
        !request.resource.data.keys().hasAny(['role'])
        || request.resource.data.role == 'user'
      );
      allow update: if isSignedIn() && (
        request.auth.uid == userId
        || (request.auth.token.email != null && request.auth.token.email == userId)
      ) && (
        !request.resource.data.keys().hasAny(['role'])
        || !resource.data.keys().hasAny(['role'])
        || request.resource.data.role == resource.data.role
      );
      // Staff-jogok szétválasztva: az admin (egy település kezelője) létrehozhat
      // és szerkeszthet felhasználói doksit, de a SZEREPET nem változtathatja és
      // nem törölhet. Szerep-adás (pl. admin kinevezés) és törlés = developer.
      allow create: if isAdmin();
      allow update: if isDeveloper()
        || (isAdmin() && (
          !request.resource.data.keys().hasAny(['role'])
          || (resource.data.keys().hasAny(['role'])
              && request.resource.data.role == resource.data.role)
        ));
      allow delete: if isDeveloper();
    }

    match /usernames/{normalizedName} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // Leaderboard: anyone can read; users can only update their own entry
    // with display name only — points must match their stored user_progress
    match /public_leaderboard/{userId} {
      allow read: if true;
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Admin: full write access
      allow create, update: if isAdmin();

      // User: can write their own entry, but points must match user_progress.totalPoints
      // and the user_progress document must exist (prevents bypass via missing doc).
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/user_progress/$(userId))
        && request.resource.data.points ==
             get(/databases/$(database)/documents/user_progress/$(userId)).data.totalPoints;
    }

    // Projektenkénti ranglista. Kizárólag a szerver (redeemQr, Admin SDK) írja,
    // ezért a kliens-írás tiltott – így a pontszám nem hamisítható.
    match /leaderboards/{projectId}/entries/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /trips/{tripId} {
      allow read: if true;
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if canDeleteContent();
    }

    match /stations/{stationId} {
      allow read: if true;
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if canDeleteContent();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if canDeleteContent();
    }

    match /accommodations/{accommodationId} {
      allow read: if true;
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if canDeleteContent();
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if canDeleteContent();
    }

    match /about/{aboutId} {
      allow read: if true;
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if canDeleteContent();
    }

    match /contact/{contactId} {
      allow read: if true;
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if canDeleteContent();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow create: if canCreateContent();
      allow update: if canUpdateContent();
      allow delete: if canDeleteContent();
    }

    // QR-kód -> cél (állomás/esemény) leképezés. Az admin felület tartja
    // karban, a redeemQr Cloud Function Admin SDK-val olvassa (a rules
    // megkerülésével). Kliens nem olvashatja, így a QR-értékek nem
    // enumerálhatók a nyilvános kollekciókból való kigyűjtéssel.
    match /qr_codes/{codeId} {
      allow read, write: if isAdmin();
    }

    match /bug_reports/{reportId} {
      allow create: if isSignedIn();
      // Admins read everything; a signed-in user may read their own reports
      // so the in-app "previous reports" history works (query is filtered by
      // reported_by.user_id == request.auth.uid).
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.reported_by.user_id == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Daily analytics snapshots written by the admin dashboard (one doc per day).
    // Internal-only: admins read and write, nobody else.
    match /stats_daily/{day} {
      allow read, write: if isAdmin();
    }
  }
}

